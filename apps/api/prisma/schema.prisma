// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum LayoutStatus {
    ACTIVE
    INACTIVE
}

model Location {
    id          Int       @id @default(autoincrement())
    name        String    @unique
    countryCode String
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?

    layouts Layout[]

    @@map("locations")
}

model Layout {
    uuid        String       @id @default(cuid())
    name        String       @unique
    description String?
    locationId  Int?
    status      LayoutStatus @default(INACTIVE)
    canvas      Json?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    deletedAt   DateTime?

    location    Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
    layoutItems LayoutItem[]

    @@map("layouts")
}

model LayoutItem {
    uuid          String   @id @default(cuid())
    layoutId      String
    name          String
    isBookable    Boolean  @default(false)
    bookingTypeId Int?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    layout      Layout       @relation(fields: [layoutId], references: [uuid], onDelete: Cascade)
    bookingType BookingType? @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)

    @@unique([layoutId, name])
    @@map("layout_items")
}

model BookingType {
    id          Int       @id @default(autoincrement())
    name        String    @unique
    description String?
    icon        String?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
    deletedAt   DateTime?

    layoutItems LayoutItem[]

    @@map("booking_types")
}
